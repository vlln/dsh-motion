{
  "name": "@vlln/dsh-motion",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Motion render kernel as a dsh plugin: timeline + text slots + palette + comments -> frame-accurate MP4",
  "scripts": {
    "audio": "node scripts/synth.mjs && node scripts/beats.mjs && node scripts/wave.mjs",
    "sheet": "node scripts/capture.mjs --stills 0,2.5,5,7.5,10,12.5 --cols 3 --out out/sheet.png",
    "video": "node scripts/capture.mjs --video --out out/demo.mp4",
    "gates": "node scripts/gates.mjs",
    "gate:audio": "node scripts/gate-audio.mjs",
    "validate": "node scripts/validate-tests.mjs",
    "gate:validate": "node scripts/validate-tests.mjs",
    "preview": "node scripts/serve.mjs",
    "gate:ui": "node scripts/gate-ui.mjs",
    "gate:comments": "node scripts/gate-comments.mjs",
    "comments": "node scripts/comments.mjs",
    "texts": "node scripts/texts.mjs",
    "gate:plugin": "node scripts/gate-plugin.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "timeline.json",
    "src",
    "scripts",
    "README.md"
  ]
}