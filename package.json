{
  "name": "@vlln/dsh-motion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Motion render kernel as a dsh plugin: timeline + text slots + palette + comments -> frame-accurate MP4",
  "scripts": {
    "audio": "node scripts/synth.mjs && node scripts/beats.mjs && node scripts/wave.mjs",
    "sheet": "node scripts/capture.mjs --stills 0,2.5,5,7.5,10,12.5 --cols 3 --out out/sheet.png",
    "video": "node scripts/capture.mjs --video --out out/demo.mp4",
    "gates": "node scripts/gates.mjs",
    "gate:audio": "node scripts/gate-audio.mjs",
    "validate": "node scripts/validate-tests.mjs",
    "gate:validate": "node scripts/validate-tests.mjs",
    "preview": "node scripts/serve.mjs",
    "dev:host": "node scripts/verify-standalone.mjs",
    "gate:ui": "node scripts/gate-ui.mjs",
    "gate:comments": "node scripts/gate-comments.mjs",
    "comments": "node scripts/comments.mjs",
    "texts": "node scripts/texts.mjs",
    "gate:plugin": "node scripts/gate-plugin.mjs",
    "link": "node scripts/dev-link.mjs",
    "build:client": "node scripts/build-client.mjs",
    "gate:client": "node scripts/gate-client.mjs",
    "check": "npm run validate && npm run gates && npm run gate:audio && npm run gate:ui && npm run gate:layout && npm run gate:comments && npm run gate:params && npm run gate:surface && npm run gate:reference && npm run gate:text && npm run gate:media && npm run gate:tweaks && npm run gate:scale && npm run gate:values && npm run gate:assets && npm run gate:scene && npm run gate:export && npm run gate:project && npm run gate:live && npm run gate:client && npm run gate:bundle && npm run gate:plugin && npm run gate:frames && npm run gate:fonts && npm run gate:beats && npm run gate:poster",
    "gate:film": "node scripts/gate-film.mjs",
    "gate:layout": "node scripts/gate-layout.mjs",
    "gate:params": "node scripts/gate-params.mjs",
    "gate:surface": "node scripts/gate-surface.mjs",
    "gate:reference": "node scripts/gate-reference.mjs",
    "gate:text": "node scripts/gate-text.mjs",
    "gate:media": "node scripts/gate-media.mjs",
    "gate:tweaks": "node scripts/gate-tweaks.mjs",
    "gate:scale": "node scripts/gate-scale.mjs",
    "gate:values": "node scripts/gate-values.mjs",
    "gate:assets": "node scripts/gate-assets.mjs",
    "gate:scene": "node scripts/gate-scene.mjs",
    "gate:export": "node scripts/gate-export.mjs",
    "gate:project": "node scripts/gate-project.mjs",
    "gate:live": "node scripts/gate-live.mjs",
    "assets": "node scripts/assets.mjs prep",
    "gate:frames": "node scripts/gate-frames.mjs",
    "gate:fonts": "node scripts/gate-fonts.mjs",
    "gate:beats": "node scripts/gate-beats.mjs",
    "gate:poster": "node scripts/gate-poster.mjs",
    "gate:bundle": "node scripts/gate-bundle.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "1.64.1"
  },
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "bin",
    "skills",
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "timeline.json",
    "src",
    "scripts",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "dsh-motion": "./bin/dsh-motion.mjs"
  }
}
